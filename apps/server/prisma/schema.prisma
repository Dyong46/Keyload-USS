// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Customer {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  phone        String        @unique
  vehicles     Vehicle[]
  appointments Appointment[]

  @@map("customers")
}

model Vehicle {
  id                           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId                   String        @map("customer_id") @db.Uuid
  registrationNumber           String        @unique @map("registration_number")
  registrationNumberNormalized String        @unique @map("registration_number_normalized")
  make                         String
  model                        String
  customer                     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointments                 Appointment[] @relation("AppointmentVehicle")

  @@unique([id, customerId])
  @@index([customerId])
  @@map("vehicles")
}

model Dealership {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique
  technicians  Technician[]
  serviceBays  ServiceBay[]
  appointments Appointment[]

  @@map("dealerships")
}

model ServiceType {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                  @unique
  durationMinutes        Int                     @map("duration_minutes")
  technicianAssociations TechnicianServiceType[]
  appointmentServices    AppointmentService[]

  @@map("service_types")
}

model Technician {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealershipId String                  @map("dealership_id") @db.Uuid
  name         String
  dealership   Dealership              @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  serviceTypes TechnicianServiceType[]
  appointments Appointment[]           @relation("AppointmentTechnician")

  @@unique([dealershipId, name])
  @@index([dealershipId, id])
  @@map("technicians")
}

model TechnicianServiceType {
  technicianId  String      @map("technician_id") @db.Uuid
  serviceTypeId String      @map("service_type_id") @db.Uuid
  technician    Technician  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@id([technicianId, serviceTypeId])
  @@index([serviceTypeId, technicianId])
  @@map("technician_service_types")
}

model ServiceBay {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealershipId String        @map("dealership_id") @db.Uuid
  label        String
  dealership   Dealership    @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  appointments Appointment[] @relation("AppointmentServiceBay")

  @@unique([dealershipId, label])
  @@unique([id, dealershipId])
  @@index([dealershipId, id])
  @@map("service_bays")
}

model Appointment {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId           String               @map("customer_id") @db.Uuid
  vehicleId            String               @map("vehicle_id") @db.Uuid
  dealershipId         String               @map("dealership_id") @db.Uuid
  technicianId         String               @map("technician_id") @db.Uuid
  serviceBayId         String               @map("service_bay_id") @db.Uuid
  status               AppointmentStatus    @default(CONFIRMED)
  scheduledStart       DateTime             @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd         DateTime             @map("scheduled_end") @db.Timestamptz(3)
  totalDurationMinutes Int                  @map("total_duration_minutes")
  occupancyEnd         DateTime             @map("occupancy_end") @db.Timestamptz(3)
  requestKey           String               @unique @map("request_key") @db.Uuid
  requestHash          String               @map("request_hash") @db.Char(64)
  cancelledAt          DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  actualCompletedAt    DateTime?            @map("actual_completed_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle              Vehicle              @relation("AppointmentVehicle", fields: [vehicleId, customerId], references: [id, customerId], onDelete: Restrict)
  dealership           Dealership           @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  technician           Technician           @relation("AppointmentTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  serviceBay           ServiceBay           @relation("AppointmentServiceBay", fields: [serviceBayId, dealershipId], references: [id, dealershipId], onDelete: Restrict)
  services             AppointmentService[]

  @@index([scheduledStart, id])
  @@index([dealershipId, status, scheduledStart])
  @@index([vehicleId, scheduledStart])
  @@index([technicianId, scheduledStart])
  @@index([serviceBayId, scheduledStart])
  @@map("appointments")
}

model AppointmentService {
  appointmentId   String      @map("appointment_id") @db.Uuid
  serviceTypeId   String      @map("service_type_id") @db.Uuid
  name            String      @map("name_snapshot")
  durationMinutes Int         @map("duration_minutes_snapshot")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceType     ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceTypeId])
  @@index([serviceTypeId])
  @@map("appointment_services")
}
